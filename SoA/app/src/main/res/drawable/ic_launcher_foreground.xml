<?xml version="1.0" encoding="utf-8"?>
<!-- Game controller (pill-shaped body, D-pad + two face buttons cut out as
     clean full-circle holes via evenOdd fill) with a wrench laid diagonally
     ABOVE it, its lower jaw overlapping the controller's top edge - "a
     wrench over the controller", per the user's request. The background is
     blue (drawable/ic_launcher_background.xml) - this layer is
     white-on-transparent only.

     The wrench glyph is Material Design's "build" icon path, used
     unmodified inside its own group (translate+scale only, no hand-edited
     coordinates - much less error-prone than baking the transform into the
     path data by hand).

     Everything is wrapped in one more outer group, scaled down and
     recentered around the canvas center, so the whole combined shape sits
     inside the adaptive-icon safe zone (66dp circle) with a little margin,
     instead of crowding or spilling past its edge. This whole layout was
     drafted and checked against safe-zone/circle-mask guide overlays in a
     plain SVG rendering before being ported here 1:1 (the affine math for
     both groups was hand-verified point-by-point against the SVG version -
     see the chat history if this ever needs re-deriving). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Scales the whole controller+wrench composition down by 0.78 around
         (54,50) - roughly the combined shape's own bounding-box center -
         then nudges it down by 4 so that center lands on the canvas center
         (54,54). -->
    <group
        android:pivotX="54"
        android:pivotY="50"
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:translateY="4">

        <!-- Controller body (pill/stadium shape) with the D-pad and the two
             face buttons subtracted as holes (evenOdd: nested closed shapes
             become negative space, showing the blue background through).
             The two face-button circles are each drawn as two 180-degree
             arcs back to the start point - the previous version used a
             single-arc-then-close pattern that rendered as a "bitten"
             pac-man shape instead of a full circle on-device. -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="
                M30,60 L78,60 A15,15 0 0 1 78,90 L30,90 A15,15 0 0 1 30,60 Z
                M36,69 L41,69 L41,74 L46,74 L46,79 L41,79 L41,84 L36,84 L36,79 L31,79 L31,74 L36,74 Z
                M60,70 A4,4 0 1 1 60,78.0001 A4,4 0 1 1 60,70
                M70,80 A4,4 0 1 1 70,88.0001 A4,4 0 1 1 70,80" />

        <!-- Wrench, laid diagonally so its lower (open) jaw overlaps the
             controller's top edge - reads as "resting on top of" it. -->
        <group
            android:pivotX="0"
            android:pivotY="0"
            android:scaleX="2.15"
            android:scaleY="2.15"
            android:translateX="28"
            android:translateY="10">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z" />
        </group>
    </group>
</vector>
